<!-- Marque « o » de oney : disque jaune, personnage poussant un diable.
     Dessin exprime dans un repere 0-100, cale dans la zone de securite
     (72 dp centres sur 108) par le groupe ci-dessous. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.02"
        android:scaleY="1.02"
        android:translateX="3"
        android:translateY="3">

        <!-- Disque jaune (cercle r=35 centre en 50,50) -->
        <path
            android:fillColor="#FFC220"
            android:pathData="M15,50 a35,35 0 1,0 70,0 a35,35 0 1,0 -70,0 Z" />

        <!-- Buste -->
        <path
            android:strokeColor="#111318"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:pathData="M35,38 L40,51" />
        <!-- Bras vers la poignee -->
        <path
            android:strokeColor="#111318"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:pathData="M36,40 L54,44" />
        <!-- Jambe avant -->
        <path
            android:strokeColor="#111318"
            android:strokeWidth="5.5"
            android:strokeLineCap="round"
            android:pathData="M40,51 L48,65" />
        <!-- Jambe arriere -->
        <path
            android:strokeColor="#111318"
            android:strokeWidth="5.5"
            android:strokeLineCap="round"
            android:pathData="M40,51 L31,63" />
        <!-- Montant du diable -->
        <path
            android:strokeColor="#111318"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M54,41 L60,67" />
        <!-- Semelle du diable -->
        <path
            android:strokeColor="#111318"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M56,66 L70,66" />

        <!-- Tete (cercle r=5.5 centre en 36,32) -->
        <path
            android:fillColor="#111318"
            android:pathData="M30.5,32 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z" />
        <!-- Carton -->
        <path
            android:fillColor="#111318"
            android:pathData="M56,44 h17 v16 h-17 Z" />
        <!-- Roue -->
        <path
            android:fillColor="#111318"
            android:pathData="M60,70 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
        <path
            android:fillColor="#FFC220"
            android:pathData="M63.2,70 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0 Z" />
    </group>
</vector>
