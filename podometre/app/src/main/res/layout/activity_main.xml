<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/setup"
            style="@style/Primary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ready"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Compteur du jour -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="0dp"
                    android:text="Pas aujourd\'hui (toutes sources)" />

                <TextView
                    android:id="@+id/total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/green"
                    android:textSize="46sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Ajout en une fois -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="Ajouter une marche" />

                <TextView
                    style="@style/Label"
                    android:text="Les pas sont répartis minute par minute sur la durée, à une cadence de marche réaliste." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/quick2k"
                        style="@style/Quick"
                        android:text="2 000" />

                    <Button
                        android:id="@+id/quick5k"
                        style="@style/Quick"
                        android:text="5 000" />

                    <Button
                        android:id="@+id/quick10k"
                        style="@style/Quick"
                        android:text="10 000" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:text="Nombre de pas" />

                <EditText
                    android:id="@+id/steps"
                    style="@style/Field"
                    android:text="5000" />

                <TextView
                    style="@style/Label"
                    android:text="Durée de la marche (minutes)" />

                <EditText
                    android:id="@+id/duration"
                    style="@style/Field"
                    android:hint="auto" />

                <TextView
                    style="@style/Label"
                    android:text="Marche terminée il y a (minutes)" />

                <EditText
                    android:id="@+id/endAgo"
                    style="@style/Field"
                    android:hint="0 = maintenant" />

                <TextView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/add"
                    style="@style/Primary"
                    android:text="Ajouter les pas" />
            </LinearLayout>

            <!-- Marche en direct -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="Marche en direct" />

                <TextView
                    style="@style/Label"
                    android:text="Ajoute des pas en continu (environ 110 par minute) tant que l\'appli reste ouverte. L\'écran reste allumé." />

                <TextView
                    android:id="@+id/live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/green"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/liveToggle"
                    style="@style/Primary"
                    android:text="Démarrer la marche" />
            </LinearLayout>

            <!-- Reglages -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="Si le challenge ne voit pas les pas" />

                <TextView
                    style="@style/Label"
                    android:text="1. L\'appli du challenge doit lire ses pas depuis Health Connect.\n2. Dans Health Connect › Données et accès › Pas › Sources de données, place Podomètre en premier : sinon les pas réels du téléphone passent avant sur les mêmes heures." />

                <Button
                    android:id="@+id/openHc"
                    style="@style/Secondary"
                    android:layout_marginTop="6dp"
                    android:text="Ouvrir Health Connect" />

                <Button
                    android:id="@+id/clear"
                    style="@style/Secondary"
                    android:text="Effacer les pas ajoutés aujourd\'hui"
                    android:textColor="@color/error" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
